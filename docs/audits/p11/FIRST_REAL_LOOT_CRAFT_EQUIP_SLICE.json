  "logicStages": [
    {
      "step": 1,
      "id": "source",
      "action": "Wolf and skeleton drop original HIGHFLY items; copper/iron ore from veins",
      "status": "MISSING_RUNTIME"
    },
    {
      "step": 2,
      "id": "bag",
      "action": "Move real obtained objects to one persistent inventory, no double-grants",
      "status": "MISSING_RUNTIME"
    },
    {
      "step": 3,
      "id": "smelt",
      "action": "Refine each specific ore into matching ingot; existing generic ore recipes to be migrated",
      "status": "MISSING_RUNTIME"
    },
    {
      "step": 4,
      "id": "forge",
      "action": "Craft an iron chestplate and other gear using validated materials/skill",
      "status": "MISSING_RUNTIME"
    },
    {
      "step": 5,
      "id": "quality",
      "action": "Determine rarity per item instance, spawn every item at +0",
      "status": "SPEC_APPROVED"
    },
    {
      "step": 6,
      "id": "equip",
      "action": "Equip chestplate; apply stats to actual combat and attributes panel; no visual mesh change",
      "status": "MISSING_RUNTIME"
    },
    {
      "step": 7,
      "id": "upgrade",
      "action": "Explicit player enhancement +1...+9, full cost and ownership checks",
      "status": "MISSING_RUNTIME_NEW_GEAR"
    },
    {
      "step": 8,
      "id": "save",
      "action": "Persist unique instance ID, rarity and enhancement across reload",
      "status": "MISSING_RUNTIME_NEW_GEAR"
    },
    {
      "step": 9,
      "id": "trade",
      "action": "Later player marketplace transfers same instance with its upgrade and rarity",
      "status": "FUTURE_MARKETPLACE"
    }
  ],
