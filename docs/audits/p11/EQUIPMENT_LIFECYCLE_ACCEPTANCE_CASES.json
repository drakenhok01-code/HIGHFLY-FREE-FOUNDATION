    {
      "id": "existing_player_upgrade_can_reach_three",
      "given": {
        "action": "PLAYER_UPGRADE",
        "itemInstance": {
          "instanceId": "example-001",
          "templateId": "hf_iron_chest",
          "rarity": "Raro",
          "plus": 2
        }
      },
      "expected": {
        "instanceId": "example-001",
        "rarity": "Raro",
        "plus": 3,
        "noNewInstance": true
      }
    },
    {
      "id": "trade_retains_existing_plus",
      "given": {
        "action": "PLAYER_TO_PLAYER_TRADE",
        "seller": "A",
        "buyer": "B",
        "itemInstance": {
          "instanceId": "example-001",
          "templateId": "hf_iron_chest",
          "rarity": "Raro",
          "plus": 3
        }
      },
      "expected": {
        "sellerOwnsInstance": false,
        "buyerOwnsInstance": true,
        "instanceId": "example-001",
        "rarity": "Raro",
        "plus": 3,
        "createdNewItem": false
      }
    },
    {
      "id": "stat_only_chest_no_visual_change",
      "given": {
        "action": "EQUIP",
        "slot": "chest",
        "itemInstance": {
          "instanceId": "example-001",
          "templateId": "hf_iron_chest",
          "rarity": "Raro",
          "plus": 3
        }
      },
      "expected": {
        "equipped": true,
        "bonusesShown": true,
        "bonusesAppliedToCombat": true,
        "characterVisualArmorMeshUnchanged": true,
        "characterCount": 1
      }
    },
    {
      "id": "unequip_restores_item_and_stats",
      "given": {
        "action": "UNEQUIP",
        "slot": "chest",
        "itemInstance": {
          "instanceId": "example-001",
          "templateId": "hf_iron_chest",
          "rarity": "Raro",
          "plus": 3
        }
      },
      "expected": {
        "inBag": true,
        "plus": 3,
        "bonusRemoved": true,
        "noNewInstance": true
      }
    },
    {
      "id": "saving_loading_does_not_reset_plus",
      "given": {
        "action": "SAVE_LOAD",
        "itemInstance": {
          "instanceId": "example-001",
          "templateId": "hf_iron_chest",
          "rarity": "Raro",
          "plus": 3
        }
      },
      "expected": {
        "instanceId": "example-001",
        "rarity": "Raro",
        "plus": 3
      }
    },
    {
      "id": "character_is_always_universal",
      "given": {
        "action": "EQUIP",
        "item": "hf_iron_chest",
        "character": "hunter_universal"
      },
      "expected": {
        "noClassRestriction": true,
        "noCharacterSwitch": true
      }
