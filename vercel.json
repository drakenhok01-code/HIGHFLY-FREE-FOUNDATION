{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/HIGHFLY-FREE-FOUNDATION/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/HIGHFLY-FREE-FOUNDATION",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/HIGHFLY-FREE-FOUNDATION/highfly/premium/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
